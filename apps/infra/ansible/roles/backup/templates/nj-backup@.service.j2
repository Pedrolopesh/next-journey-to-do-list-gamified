# Managed by Ansible. Backup of one environment's database, or of the vault (the instance name).
[Unit]
Description=Backup (%i)
After=docker.service openbao.service
Wants=docker.service
StartLimitIntervalSec=6h
StartLimitBurst=4

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nj-backup %i
Restart=on-failure
RestartSec=15min

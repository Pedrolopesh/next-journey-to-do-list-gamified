#!/bin/bash
# Watches the vault and tells the admin about it.
#   watch (every 30 s, by timer): alerts when the vault is sealed (again every NJ_REMIND_SECONDS), and when
#         it is opened it starts the environments that were waiting and reports it.
#   boot  (once, after a reboot): waits for the vault, then reports the state of the whole host.
set -uo pipefail
mode="${1:-watch}"
state_dir="${NJ_STATE_DIR:-/run/nj-alerts}"
conf_dir="${NJ_CONF_DIR:-/etc/nextjourney}"
vault="${NJ_VAULT_ADDR:-https://127.0.0.1:8200}"
cacert="${NJ_VAULT_CACERT:-/etc/openbao/tls/openbao.crt}"
notify="${NJ_NOTIFY:-/usr/local/sbin/nj-notify}"
remind="${NJ_REMIND_SECONDS:-900}"
envs=(dev prd)
install -d -m 0700 "$state_dir"

vault_state() {
  local code
  code=$(curl -sS --max-time 5 --cacert "$cacert" -o /dev/null -w '%{http_code}' "${vault}/v1/sys/health" 2>/dev/null) \
    || { echo unreachable; return; }
  case "$code" in
    200 | 429 | 472 | 473) echo open ;;
    503) echo sealed ;;
    501) echo uninitialized ;;
    *) echo unreachable ;;
  esac
}

env_port() { sed -n "s/^NJ_PORT=['\"]\{0,1\}\([0-9]*\).*/\1/p" "${conf_dir}/${1}.env" 2>/dev/null | head -n1; }

env_healthy() {
  local port
  port=$(env_port "$1")
  [ -n "$port" ] && curl -fsS --max-time 5 -o /dev/null "http://127.0.0.1:${port}/health" 2>/dev/null
}

sealed_alert() { # rate limited: once, then every $remind seconds
  local now last_alert
  now=$(date +%s)
  last_alert=$(cat "${state_dir}/last_alert" 2>/dev/null || echo 0)
  if [ "$1" = force ] || [ $((now - last_alert)) -ge "$remind" ]; then
    "$notify" critical "Vault is SEALED. Environments cannot restart until it is opened. Open it with: ssh -t <admin-user>@<host> sudo nj-unseal (3 key shares)."
    echo "$now" >"${state_dir}/last_alert"
  fi
}

start_waiting_environments() {
  local env started=() failed=()
  for env in "${envs[@]}"; do
    systemctl is-enabled --quiet "nj@${env}.service" 2>/dev/null || continue
    systemctl is-active --quiet "nj@${env}.service" 2>/dev/null && continue
    if systemctl start "nj@${env}.service" 2>/dev/null && env_healthy "$env"; then started+=("$env"); else failed+=("$env"); fi
  done
  if [ "${#failed[@]}" -gt 0 ]; then
    "$notify" warning "Vault opened, but these environments did not come up: ${failed[*]}. Check the nj@ units."
  elif [ "${#started[@]}" -gt 0 ]; then
    "$notify" ok "Vault opened. Environments started: ${started[*]}."
  else
    "$notify" ok "Vault opened. Environments were already running."
  fi
}

do_watch() {
  local state last
  state=$(vault_state)
  last=$(cat "${state_dir}/last" 2>/dev/null || echo unknown)
  case "$state" in
    sealed) sealed_alert "" ;;
    open) [ "$last" = sealed ] && start_waiting_environments ;;
    *) [ "$last" != "$state" ] && "$notify" warning "Vault is ${state}." ;;
  esac
  echo "$state" >"${state_dir}/last"
  return 0
}

do_boot() {
  local state i env problems=() cert disk
  for i in $(seq 1 60); do # up to 5 minutes for the vault container to answer
    state=$(vault_state)
    [ "$state" != unreachable ] && break
    sleep 5
  done
  echo "$state" >"${state_dir}/last"
  if [ "$state" = sealed ]; then
    sealed_alert force
    return 0
  fi
  [ "$state" = open ] || problems+=("vault ${state}")
  for env in "${envs[@]}"; do
    systemctl is-enabled --quiet "nj@${env}.service" 2>/dev/null || continue
    env_healthy "$env" || problems+=("${env} not healthy")
    [ -s "/run/nj-${env}/secrets/jwt_access_secret" ] || problems+=("${env} secrets missing")
  done
  systemctl is-active --quiet nginx 2>/dev/null || problems+=("nginx not running")
  disk=$(df --output=pcent / 2>/dev/null | tail -n1 | tr -dc '0-9')
  [ "${disk:-0}" -lt 85 ] || problems+=("disk at ${disk}%")
  for cert in /etc/letsencrypt/live/*/cert.pem; do
    [ -e "$cert" ] || continue
    openssl x509 -checkend 1209600 -noout -in "$cert" >/dev/null 2>&1 || problems+=("a certificate expires in under 14 days")
  done
  if [ "${#problems[@]}" -eq 0 ]; then
    "$notify" ok "Reboot finished. Vault open, environments healthy, nginx, certificates and disk ok."
  else
    "$notify" warning "Reboot finished with problems: $(IFS=';'; echo "${problems[*]}")"
  fi
}

case "$mode" in
  watch) do_watch ;;
  boot) do_boot ;;
  *) echo "usage: nj-vault-watch [watch|boot]" >&2; exit 2 ;;
esac

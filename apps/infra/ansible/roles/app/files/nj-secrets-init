#!/bin/bash
# Creates (once) the encrypted secrets of an environment with systemd-creds. Never prints values.
# Usage: nj-secrets-init <dev|prd>
set -euo pipefail
env="${1:?usage: nj-secrets-init <dev|prd>}"
dir="/etc/nextjourney/creds/${env}"
install -d -m 0700 "$dir"
umask 077

put() { # put <name> (value on stdin); never overwrites
  local name="$1"
  if [ -e "${dir}/${name}.cred" ]; then cat >/dev/null; return 0; fi
  systemd-creds encrypt --name="$name" - "${dir}/${name}.cred"
  echo "created: ${name}"
}

if [ ! -e "${dir}/postgres_password.cred" ]; then
  pw=$(openssl rand -hex 24)
  printf %s "$pw" | put postgres_password
  printf %s "postgresql://nj:${pw}@db:5432/nj" | put database_url
  unset pw
fi
[ -e "${dir}/jwt_access_secret.cred" ] || openssl rand -base64 48 | tr -d '\n' | put jwt_access_secret
# Email provider key: starts empty and is filled in later (see the deploy runbook)
[ -e "${dir}/resend_api_key.cred" ] || printf '' | put resend_api_key

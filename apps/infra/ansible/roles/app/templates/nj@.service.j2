# Managed by Ansible. Starts and stops the stack of one environment (dev or prd).
[Unit]
Description=Next Journey API (%i)
Requires=docker.service nj-secrets@%i.service
After=docker.service nj-secrets@%i.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile={{ app_conf_dir }}/common.env
EnvironmentFile={{ app_conf_dir }}/%i.env
Environment=NJ_ENV=%i NJ_SECRETS_DIR=/run/nj-%i/secrets
ExecStart=/usr/bin/docker compose -f {{ app_dir }}/compose.yml up -d --remove-orphans --wait --wait-timeout 120
ExecReload=/usr/bin/docker compose -f {{ app_dir }}/compose.yml up -d --remove-orphans --wait --wait-timeout 120
ExecStop=/usr/bin/docker compose -f {{ app_dir }}/compose.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target

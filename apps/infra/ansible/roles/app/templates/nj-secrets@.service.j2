# Managed by Ansible. Puts the environment secrets in a tmpfs (gone after a reboot), from the local
# credentials or from the vault (see secrets-<env>.conf).
[Unit]
Description=Next Journey secrets (%i) in tmpfs
After=local-fs.target openbao.service
Wants=openbao.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-{{ app_conf_dir }}/secrets-%i.conf
LoadCredentialEncrypted=postgres_password:{{ app_conf_dir }}/creds/%i/postgres_password.cred
LoadCredentialEncrypted=database_url:{{ app_conf_dir }}/creds/%i/database_url.cred
LoadCredentialEncrypted=jwt_access_secret:{{ app_conf_dir }}/creds/%i/jwt_access_secret.cred
LoadCredentialEncrypted=resend_api_key:{{ app_conf_dir }}/creds/%i/resend_api_key.cred
ExecStart=/usr/local/sbin/nj-materialize %i
ExecStop=/bin/rm -rf /run/nj-%i

[Install]
WantedBy=multi-user.target

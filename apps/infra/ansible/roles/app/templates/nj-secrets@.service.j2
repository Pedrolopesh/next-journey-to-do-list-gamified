# Managed by Ansible. Puts the environment secrets in a tmpfs (gone after a reboot), read from the vault.
[Unit]
Description=Next Journey secrets (%i) in tmpfs
After=local-fs.target openbao.service
Wants=openbao.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/nj-materialize %i
ExecStop=/bin/rm -rf /run/nj-%i

[Install]
WantedBy=multi-user.target

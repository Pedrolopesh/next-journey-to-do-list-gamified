# Managed by Ansible. The 10- prefix wins over 50-cloud-init.conf (sshd uses the first value it reads).
PermitRootLogin prohibit-password
PasswordAuthentication {{ 'no' if ssh_disable_password_auth | default(false) else 'yes' }}
KbdInteractiveAuthentication no
PubkeyAuthentication yes
MaxAuthTries 3
LoginGraceTime 30
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
ClientAliveInterval 300
ClientAliveCountMax 2
AllowUsers root {{ deploy_user }}{% if release_ci_ssh_public_key | default('') | length > 0 %} {{ release_ci_user | default('nj-ci') }}{% endif %}
{% for address in ssh_forwarding_addresses | default([]) %}

# An editor (VS Code Remote-SSH) tunnels to a server it starts on the loopback. Only the deploy user, only
# from this admin address, and only to the host itself, so the host cannot be used as a bridge.
Match User {{ deploy_user }} Address {{ address }}
    AllowTcpForwarding local
    PermitOpen 127.0.0.1:* localhost:* [::1]:*
{% endfor %}

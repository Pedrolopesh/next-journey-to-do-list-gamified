# Next Journey API. Build context = monorepo root.
# Targets: "runtime" (default, production only) and "migrate" (migrations and seed, one-off use).
# Base images pinned by digest.
ARG NODE_IMAGE=node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205

FROM ${NODE_IMAGE} AS base
ENV PNPM_HOME=/pnpm CI=true COREPACK_HOME=/opt/corepack
ENV PATH=$PNPM_HOME:$PATH
# openssl before install: Prisma picks the migration engine from the detected version
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@11.28.3 --activate && chmod -R a+rX /opt/corepack
WORKDIR /repo

# Dependencies (cached layer while the manifests do not change)
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY packages/contracts/package.json packages/contracts/
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/eslint-config/package.json packages/eslint-config/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @nextjourney/api... --store-dir /pnpm/store

# Build (contracts, Prisma client and API)
FROM deps AS build
COPY packages/ packages/
COPY apps/api/ apps/api/
# Prisma 7 requires DATABASE_URL just to read the config; the value is not used by generate.
RUN pnpm --filter @nextjourney/contracts build \
 && DATABASE_URL=postgresql://build:build@localhost:5432/build pnpm --filter @nextjourney/api prisma:generate \
 && pnpm --filter @nextjourney/api build
RUN pnpm --filter @nextjourney/api deploy --prod --legacy /out

# Migrations and seed: needs the Prisma CLI and tsx (dev dependencies)
FROM build AS migrate
ENV NODE_ENV=production PATH=/repo/apps/api/node_modules/.bin:$PATH
USER 1000:1000
WORKDIR /repo/apps/api
CMD ["./node_modules/.bin/prisma", "migrate", "deploy"]

# Final image: only what is needed to run
FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /out/node_modules ./node_modules
COPY --from=build --chown=node:node /out/package.json ./package.json
COPY --from=build --chown=node:node /repo/apps/api/dist ./dist
COPY --chown=root:root apps/infra/docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0555 /usr/local/bin/entrypoint.sh
USER 1000:1000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["node", "dist/main.js"]

// Source of truth for the database. Dates in UTC (timestamptz). The user's "local days" are kept as
// YYYY-MM-DD text (already computed in the profile time zone), so nothing depends on the server time zone.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemType {
  daily
  todo
  habit
}

enum Difficulty {
  easy
  medium
  hard
}

model User {
  id                     String    @id @default(uuid()) @db.Uuid
  email                  String    @unique
  name                   String
  timezone               String
  termsAcceptedAt        DateTime  @map("terms_accepted_at") @db.Timestamptz
  termsVersion           String    @map("terms_version")
  /// When the tutorial was seen (or skipped)
  tutorialSeenAt         DateTime? @map("tutorial_seen_at") @db.Timestamptz
  /// Daily reminder time (HH:MM), in the profile time zone
  notifyAt               String?   @map("notify_at") @db.VarChar(5)
  /// Onboarding answers (values of the enums in `packages/contracts/src/profile.ts`)
  goals                  String[]  @default([]) @db.VarChar(20)
  ageRange               String?   @map("age_range") @db.VarChar(10)
  gender                 String?   @db.VarChar(10)
  /// Whether the person turned reminders on in the notifications screen (null = has not answered yet)
  remindersOptIn         Boolean?  @map("reminders_opt_in")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz
  /// When the person proved they own the email (null = signup still pending)
  emailVerifiedAt        DateTime? @map("email_verified_at") @db.Timestamptz
  /// Last send of a code or confirmation notice (minimum interval between sends)
  verificationMailSentAt DateTime? @map("verification_mail_sent_at") @db.Timestamptz

  stats              UserStats?
  character          Character?
  identities         AuthIdentity[]
  emailVerifications EmailVerification[]
  storyProgress      StoryProgress[]
  chapterCompletions ChapterCompletion[]
  achievements       UserAchievement[]
  cosmetics          UserCosmetic[]
  refreshTokens      RefreshToken[]
  categories         Category[]
  items              Item[]
  checks             ItemCheck[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// sha256 of the token secret; the token itself is never stored
  tokenHash  String    @unique @map("token_hash")
  /// All tokens rotated from the same login share the family
  familyId   String    @map("family_id") @db.Uuid
  /// Device name reported by the app (X-Device-Name header), kept across rotation
  deviceName String?   @map("device_name") @db.VarChar(80)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Global game state: EXP, level and coins. Chapter progress is per story (StoryProgress).
model UserStats {
  userId            String    @id @map("user_id") @db.Uuid
  level             Int       @default(1)
  expInLevel        Int       @default(0) @map("exp_in_level")
  expTotal          Int       @default(0) @map("exp_total")
  coins             Int       @default(0)
  totalChecks       Int       @default(0) @map("total_checks")
  itemsCreated      Int       @default(0) @map("items_created")
  /// How many times the person changed the character look (achievements)
  lookChanges       Int       @default(0) @map("look_changes")
  /// Categories created by the person (the ones from signup do not count)
  categoriesCreated Int       @default(0) @map("categories_created")
  /// When the app reported that the daily reminder was turned on (achievement)
  reminderEnabledAt DateTime? @map("reminder_enabled_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String
  color     String
  position  Int       @default(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items Item[]

  @@index([userId])
  @@map("categories")
}

model Item {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  categoryId    String     @map("category_id") @db.Uuid
  type          ItemType
  title         String
  notes         String?
  difficulty    Difficulty
  /// Scheduled days (0 = Sunday ... 6 = Saturday); dailies only
  scheduleDays  Int[]      @map("schedule_days")
  dueAt         DateTime?  @map("due_at") @db.Timestamptz
  completedAt   DateTime?  @map("completed_at") @db.Timestamptz
  /// Local day of creation (YYYY-MM-DD)
  createdOn     String     @map("created_on") @db.VarChar(10)
  /// Last local day with an active check (YYYY-MM-DD)
  lastCheckedOn String?    @map("last_checked_on") @db.VarChar(10)
  streakCurrent Int        @default(0) @map("streak_current")
  streakBest    Int        @default(0) @map("streak_best")
  position      Int        @default(0)
  /// Starter item created by the server when the account becomes valid; it does not count as created by the user
  isExample     Boolean    @default(false) @map("is_example")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  /// Soft delete: keeps the EXP history
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category    @relation(fields: [categoryId], references: [id])
  checks   ItemCheck[]

  @@index([userId, type])
  @@index([userId, deletedAt])
  // Task history: filters by type and sorts by completion
  @@index([userId, type, completedAt])
  @@map("items")
}

/// A check. The id is the checkId (UUID v4) generated by the app: it makes the check idempotent.
model ItemCheck {
  id                String    @id @db.Uuid
  itemId            String    @map("item_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// Local day of the check (YYYY-MM-DD)
  checkedOn         String    @map("checked_on") @db.VarChar(10)
  checkedAt         DateTime  @default(now()) @map("checked_at") @db.Timestamptz
  exp               Int
  coins             Int
  countsForChapter  Boolean   @map("counts_for_chapter")
  chapterAtCheck    Int?      @map("chapter_at_check")
  /// Story in which the check counted toward the chapter (to undo on the right progress)
  storyId           String?   @map("story_id") @db.Uuid
  closedChapter     Boolean   @map("closed_chapter")
  /// To restore the daily on uncheck
  streakBefore      Int       @map("streak_before")
  lastCheckedBefore String?   @map("last_checked_before") @db.VarChar(10)
  revertedAt        DateTime? @map("reverted_at") @db.Timestamptz
  /// CheckResult returned the first time; repeating the checkId returns the same result
  result            Json

  item Item @relation(fields: [itemId], references: [id])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([itemId, revertedAt])
  @@index([userId, checkedOn])
  @@map("item_checks")
}

model GameConfig {
  key   String @id
  value Json

  @@map("game_config")
}

enum AuthProvider {
  google
  apple
}

/// Social login linked to a user (an external provider/account can belong to only one user)
model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// sha256 of "userId:code"; the code itself is never stored
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verifications")
}

/// Attempt-limit counters per account (login, signup, recovery). The key is a hash:
/// it never stores email or IP in plain text.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @map("window_start") @db.Timestamptz

  @@index([windowStart])
  @@map("rate_limits")
}

model Character {
  userId         String  @id @map("user_id") @db.Uuid
  name           String
  title          String
  /// Class chosen in onboarding (enum from `profile.ts`); null on old characters
  characterClass String? @map("character_class") @db.VarChar(20)
  skin           String
  hair           String
  outfit         String
  accessory      String?
  /// Detailed LPC look (validated by `lpcLookSchema` before saving)
  look           Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("characters")
}

model Story {
  id          String @id @default(uuid()) @db.Uuid
  slug        String @unique
  name        String
  themeColor  String @map("theme_color")
  description String
  position    Int    @default(0)

  chapters Chapter[]
  progress StoryProgress[]

  @@map("stories")
}

model Chapter {
  id       String @id @default(uuid()) @db.Uuid
  storyId  String @map("story_id") @db.Uuid
  number   Int
  title    String
  text     String
  sceneKey String @map("scene_key")

  story       Story               @relation(fields: [storyId], references: [id], onDelete: Cascade)
  completions ChapterCompletion[]

  @@unique([storyId, number])
  @@map("chapters")
}

/// Progress per story: switching stories preserves the progress of each one
model StoryProgress {
  userId          String   @map("user_id") @db.Uuid
  storyId         String   @map("story_id") @db.Uuid
  chapter         Int      @default(1)
  checksInChapter Int      @default(0) @map("checks_in_chapter")
  completed       Boolean  @default(false)
  isActive        Boolean  @default(false) @map("is_active")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([userId, storyId])
  @@index([userId, isActive])
  @@map("story_progress")
}

model ChapterCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  chapterId   String   @map("chapter_id") @db.Uuid
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@map("chapter_completions")
}

model Achievement {
  slug        String  @id
  name        String
  description String
  /// Track and class (1 bronze to 4 diamond); the catalog comes from `@nextjourney/contracts`
  trail       String
  tier        Int
  /// Name of the 24x24 badge in `@nextjourney/insignias`
  glyph       String
  /// Surprise: the description is only sent after unlocking
  secret      Boolean @default(false)
  position    Int     @default(0)

  unlocked UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId          String    @map("user_id") @db.Uuid
  achievementSlug String    @map("achievement_slug")
  unlockedAt      DateTime  @default(now()) @map("unlocked_at") @db.Timestamptz
  /// When the app confirmed the notice (modal); null = notice pending
  notifiedAt      DateTime? @map("notified_at") @db.Timestamptz

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementSlug], references: [slug], onDelete: Cascade)

  @@id([userId, achievementSlug])
  @@map("user_achievements")
}

model UserCosmetic {
  userId      String   @map("user_id") @db.Uuid
  cosmeticKey String   @map("cosmetic_key")
  /// Slug of the achievement that was unlocked
  source      String
  unlockedAt  DateTime @default(now()) @map("unlocked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, cosmeticKey])
  @@map("user_cosmetics")
}

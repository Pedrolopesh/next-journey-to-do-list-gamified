# Copie para .env (ignorado pelo Git). Todas as variáveis são validadas ao subir (src/config/env.ts).
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Mesmo usuário e senha do .env da raiz; porta e banco do docker compose local
DATABASE_URL=postgresql://nextjourney:troque-esta-senha@127.0.0.1:5544/nextjourney?schema=public

# Segredo do JWT de acesso: mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-por-um-segredo-de-pelo-menos-32-caracteres
# Emissor, audiência e identificador (kid) da chave do token de acesso (os padrões servem para um só serviço).
# JWT_ISSUER=nextjourney-api
# JWT_AUDIENCE=nextjourney-app
# JWT_KEY_ID=k1
# Só durante a troca do segredo (ver docs/SEGURANCA.md, seção 8): a chave anterior continua valendo até o fim dos tokens.
# JWT_ACCESS_SECRET_PREVIOUS=
# JWT_PREVIOUS_KEY_ID=
# Aviso opcional (https) quando a contagem de eventos de segurança passa do normal; o texto não leva dado pessoal.
# SECURITY_ALERT_WEBHOOK_URL=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# E-mail de recuperação de senha (Resend). Deixe vazio em desenvolvimento: nada é enviado.
RESEND_API_KEY=
MAIL_FROM=Next Journey <no-reply@example.com>
PASSWORD_RESET_URL=nextjourney://reset-password
PASSWORD_RESET_TTL_MINUTES=30

# Login social: client ids PÚBLICOS (não são segredos), separados por vírgula
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_ID=

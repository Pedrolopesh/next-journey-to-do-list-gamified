# Copy to .env (ignored by Git). Every variable is validated at startup (src/config/env.ts).
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Same user and password as the root .env; port and database of the local docker compose
DATABASE_URL=postgresql://nextjourney:troque-esta-senha@127.0.0.1:5544/nextjourney?schema=public

# Access JWT secret: at least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-por-um-segredo-de-pelo-menos-32-caracteres
# Issuer, audience and key identifier (kid) of the access token (the defaults work for a single service).
# JWT_ISSUER=nextjourney-api
# JWT_AUDIENCE=nextjourney-app
# JWT_KEY_ID=k1
# Only during a secret rotation (see docs/api/operacao-e-seguranca.md): the previous key stays valid until its tokens end.
# JWT_ACCESS_SECRET_PREVIOUS=
# JWT_PREVIOUS_KEY_ID=
# Optional notice (https) when the count of security events goes above normal; the text carries no personal data.
# SECURITY_ALERT_WEBHOOK_URL=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=365

# Sign-in code email (Resend). Leave empty in development: nothing is sent and the code goes to the log.
RESEND_API_KEY=
MAIL_FROM=Next Journey <no-reply@example.com>

# Social login: PUBLIC client ids (not secrets), comma separated
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_ID=

# Creates the starter items when the account becomes valid (true by default)
SEED_STARTER_ITEMS=true

# Contact for personal data requests, shown in the Terms and the Privacy Policy.
# Without a value, the contact section does not appear.
# LEGAL_CONTACT_EMAIL=

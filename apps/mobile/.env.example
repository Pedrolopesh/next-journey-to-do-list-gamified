# Copie para .env (ignorado pelo Git). EXPO_PUBLIC_* é embutido no app e visível para qualquer pessoa:
# NUNCA coloque segredo aqui, só a URL pública da API.
#
# Desenvolvimento no computador, contra o servidor de dev (hospedado): a URL https do ambiente de dev.
# Desenvolvimento contra a API local: emulador Android http://10.0.2.2:3000; simulador iOS
# http://localhost:3000; aparelho físico, o IP do computador na mesma rede.
# Build de produção: a URL vem das variáveis do ambiente `production` do EAS, nunca deste arquivo,
# e precisa ser https (o app não inicia sem isso).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Login social (client ids públicos). Sem o client id Web do Google o botão não aparece.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Esquema de URL do client id iOS (com.googleusercontent.apps.<id>), usado no build
GOOGLE_IOS_URL_SCHEME=

# Copy to .env (ignored by Git). EXPO_PUBLIC_* is bundled into the app and visible to anyone:
# NEVER put a secret here, only the public API URL.
#
# Desenvolvimento no computador, contra o servidor de dev (hospedado): a URL https do ambiente de dev.
# Desenvolvimento contra a API local: emulador Android http://10.0.2.2:3000; simulador iOS
# http://localhost:3000; physical device, the computer IP on the same network.
# Production build: the URL comes from the EAS `production` environment variables, never from this file,
# and must be https (the app does not start without it).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Social login (public client ids). Without the Google Web client id the button does not show.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Esquema de URL do client id iOS (com.googleusercontent.apps.<id>), usado no build
GOOGLE_IOS_URL_SCHEME=

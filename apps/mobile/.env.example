# Copie para .env (ignorado pelo Git). EXPO_PUBLIC_* é embutido no app e visível para qualquer pessoa:
# NUNCA coloque segredo aqui, só a URL pública da API.
# Emulador Android: http://10.0.2.2:3000 (o emulador enxerga o localhost do computador por esse endereço)
# Simulador iOS: http://localhost:3000. Aparelho físico: use o IP do computador na mesma rede.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Login social (client ids públicos). Sem o client id Web do Google o botão não aparece.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Esquema de URL do client id iOS (com.googleusercontent.apps.<id>), usado no build
GOOGLE_IOS_URL_SCHEME=

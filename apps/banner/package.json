{
  "name": "@nextjourney/banner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-to-mobile.mjs && node scripts/validate-assets.mjs",
    "build:lab": "vite build --config vite.lab.config.ts && node scripts/copy-lab-assets.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:assets": "node scripts/validate-assets.mjs"
  },
  "devDependencies": {
    "@nextjourney/eslint-config": "workspace:*",
    "@nextjourney/tsconfig": "workspace:*",
    "@types/node": "^26.6.5",
    "eslint": "^9",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "*",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@nextjourney/contracts": "workspace:*",
    "@nextjourney/insignias": "workspace:*"
  }
}

{
  "name": "@nextjourney/insignias",
  "version": "0.0.0",
  "private": true,
  "description": "Arte das insígnias de conquista (pixel art 24x24) e paleta, compartilhada entre app e laboratório",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "type": "module",
  "devDependencies": {
    "@nextjourney/eslint-config": "workspace:*",
    "@nextjourney/tsconfig": "workspace:*",
    "eslint": "^10.13.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "@nextjourney/contracts": "workspace:*"
  }
}

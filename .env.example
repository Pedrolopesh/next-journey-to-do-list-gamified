# Copie para .env (ignorado pelo Git) e troque o valor. Usado só pelo docker compose local.
# Gere uma senha forte: openssl rand -base64 24
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5544

# Endurecimento da API (valores padrão entre parênteses)
# CORS_ORIGINS=            # origens web permitidas, separadas por vírgula (vazio = CORS desligado)
# TRUST_PROXY=false        # true atrás de proxy reverso, para o rate limit ver o IP real
# THROTTLE_LIMIT=120       # requisições por minuto por IP
# THROTTLE_AUTH_LIMIT=10   # idem, só nas rotas de autenticação
# ACCOUNT_PURGE_DAYS=30    # dias até apagar de vez uma conta excluída

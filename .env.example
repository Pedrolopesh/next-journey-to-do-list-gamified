# Copy to .env (ignored by Git) and change the value. Used only by the local docker compose.
# Generate a strong password: openssl rand -base64 24
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5544

# API hardening (default values in parentheses)
# CORS_ORIGINS=            # allowed web origins, comma separated (empty = CORS off)
# TRUST_PROXY=false        # true behind a reverse proxy, so the rate limit sees the real IP
# THROTTLE_LIMIT=120       # requests per minute per IP
# THROTTLE_AUTH_LIMIT=10   # same, only on the authentication routes
# ACCOUNT_PURGE_DAYS=30    # days until a deleted account is removed for good

{
  "name": "next-journey",
  "version": "0.0.0",
  "private": true,
  "description": "Next Journey: to-do list gamificado (monorepo pnpm + Turborepo)",
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "dev": "turbo dev",
    "prepare": "husky",
    "security": "bash scripts/security-scan.sh",
    "security:full": "FULL=1 bash scripts/security-scan.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.6"
  },
  "type": "module",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --flag v10_config_lookup_from_file --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,json,md,yml}": [
      "prettier --write"
    ]
  }
}
